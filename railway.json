{
  "$schema": "https://railway.app/railway.schema.json",
  "deploy": {
    "startCommand": "echo 'This is the monorepo root. Please deploy the services in the subdirectories.' && exit 1",
    "restartPolicyType": "ON_FAILURE"
  },
  "services": [
    {
      "name": "backend",
      "rootDir": "./backend",
      "healthcheckPath": "/",
      "deploy": {
        "startCommand": "uvicorn app.main:app --host 0.0.0.0 --port $PORT",
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 10
      }
    },
    {
      "name": "frontend",
      "rootDir": "./frontend",
      "healthcheckPath": "/",
      "deploy": {
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 10
      }
    }
  ]
}
