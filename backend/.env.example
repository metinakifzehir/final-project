# MongoDB
MONGODB_URI=mongodb://admin:admin123@localhost:27017/restaurantsdb?authSource=admin
MONGODB_DB_NAME=restaurantsdb

# Docker Compose (docker-compose.yml ile uyumlu)
MONGODB_PORT=27017
MONGODB_ROOT_USERNAME=admin
MONGODB_ROOT_PASSWORD=admin123

# FastAPI
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true

# Gemini ve Redis (LLM özellikleri için)
GEMINI_API_KEY=senin_gemini_api_anahtarin
REDIS_URL=redis://localhost:6379
